# your own game files and what's made from them (building from source puts them here)
input/
/ROM/
/drivers/
extracted/
generated/
generated-*/
/rando/
# Nintendo fonts (users import their own; only the README ships)
/fonts/*
!/fonts/README.md
# build output, caches, saves and settings
build/
/cache/
save/
/larecomp.ini
# tools and Python environments (machine-specific)
tools/venv/
venv/
__pycache__/
.DS_Store

# test captures (screenshots, videos from testers)
testes/

# Android native deps made by android/deps/*.sh (large, machine-specific)
/android/deps/src/
/android/deps/out/
/android/deps/work/
/android/lasrecomp/local.properties
# 签名密钥只放 Secrets / 本机 ~/.lasrecomp，不进仓库
/android/lasrecomp/ci/*.jks
